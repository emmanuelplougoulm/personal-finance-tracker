    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "engines": {
    "node": ">=24"
