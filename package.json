{
  "name": "personal-finance-tracker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:prod": "turbo run build:prod",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier .  --write",
    "prepare": "husky install",
    "test": "pnpm --filter personal-finance-tracker-web test"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-custom": "workspace:*",
    "husky": "~8.0.3",
    "prettier": "^2.8.8",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@8.15.9",
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
