{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".nuxt/**",
        ".output/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "MONGO_URI",
        "CMC_PRO_API_KEY"
      ]
    }
  }
}
